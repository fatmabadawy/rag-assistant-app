# ---- Vector store -----------------------------------------------------------
# Absolute or relative path to the Chroma store produced by the notebook.
VECTOR_STORE_DIR=./data/vector_store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Retrieval --------------------------------------------------------------
TOP_K=4
# Cosine-similarity floor. Chunks below this are discarded and, if none survive,
# the API refuses instead of calling the LLM. Raise it if you see loose answers.
MIN_SCORE=0.25

# ---- Ollama -----------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120
TEMPERATURE=0.1

# ---- Server -----------------------------------------------------------------
LOG_LEVEL=INFO
# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
